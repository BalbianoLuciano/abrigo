# Copiá este archivo a .env para desarrollo local (docker compose up -d).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://abrigo:abrigo@localhost:5432/abrigo
REDIS_URL=redis://localhost:6379
PUBLIC_APP_URL=http://localhost:8081
API_URL=http://localhost:3000

# openssl rand -hex 32
BETTER_AUTH_SECRET=

# Cifrado de mensajes. En local: claves en claro (openssl rand -base64 32).
# En producción: MESSAGE_KEY_PROVIDER=gcp-kms y claves envueltas con Cloud KMS.
MESSAGE_KEY_PROVIDER=local
MESSAGE_KEYS=1:
MESSAGE_KEY_CURRENT_VERSION=1
# KMS_KEY_NAME=projects/<p>/locations/southamerica-east1/keyRings/abrigo/cryptoKeys/messages

# Cloudflare Turnstile (vacío en local = sin captcha)
TURNSTILE_SECRET_KEY=

# Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@abrigo.ar

# Email. En local, Mailpit (http://localhost:8025)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Abrigo <avisos@abrigo.ar>

# App (Expo): variables públicas
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
