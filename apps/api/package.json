{
  "name": "@abrigo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "admin:promote": "node dist/cli/promote-admin.js",
    "db:migrate": "node ../../packages/db/dist/migrate-cli.js",
    "dev:worker": "node --watch --env-file-if-exists=../../.env dist/worker.js"
  },
  "dependencies": {
    "@abrigo/db": "workspace:*",
    "@abrigo/shared": "workspace:*",
    "@google-cloud/kms": "^6.3.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@nestjs/platform-socket.io": "^12.5.1",
    "@nestjs/websockets": "^12.5.1",
    "@node-rs/argon2": "^2.2.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "better-auth": "^1.7.25",
    "bullmq": "^6.7.7",
    "fastify": "5.12.8",
    "h3-js": "^4.5.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.5.1",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "otplib": "^13.6.0",
    "socket.io-client": "^4.8.4",
    "testcontainers": "^12.2.1",
    "unplugin-swc": "^2.0.0"
  }
}
